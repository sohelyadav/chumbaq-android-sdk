<?xml version="1.0" encoding="utf-8"?>
<!--
  Expanded view of a carousel notification.

  Only the handful of widgets RemoteViews knows how to inflate appear here —
  no ViewPager, no RecyclerView — and the text appearances come from
  androidx.core so the copy stays legible in whatever theme the system draws
  the surrounding notification template in.

  Prev/next are TextViews rather than Buttons on purpose: a Button resolves a
  style against the notification's theme at inflation time, and a layout that
  fails to inflate is a notification the user never sees.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/chumbaq_carousel_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.Compat.Notification.Title" />

    <TextView
        android:id="@+id/chumbaq_carousel_caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:textAppearance="@style/TextAppearance.Compat.Notification" />

    <ImageView
        android:id="@+id/chumbaq_carousel_image"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_marginTop="6dp"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/chumbaq_carousel_prev"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="@string/chumbaq_carousel_previous"
            android:textAppearance="@style/TextAppearance.Compat.Notification.Info" />

        <TextView
            android:id="@+id/chumbaq_carousel_indicator"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Compat.Notification.Info" />

        <TextView
            android:id="@+id/chumbaq_carousel_next"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="@string/chumbaq_carousel_next"
            android:textAppearance="@style/TextAppearance.Compat.Notification.Info" />
    </LinearLayout>
</LinearLayout>
